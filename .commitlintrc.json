{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      [
        "feat",
        "fix",
        "docs",
        "style",
        "refactor",
        "perf",
        "test",
        "chore",
        "revert",
        "ci",
        "build"
      ]
    ],
    "scope-enum": [
      2,
      "always",
      [
        "api",
        "sdk",
        "ui",
        "config",
        "build",
        "docs",
        "test",
        "release",
        "deps",
        "kotlin",
        "java",
        "android"
      ]
    ],
    "scope-case": [2, "always", "kebab-case"],
    "subject-case": [0],
    "subject-max-length": [2, "always", 100],
    "body-max-line-length": [2, "always", 200],
    "footer-max-line-length": [2, "always", 200]
  }
}